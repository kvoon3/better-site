{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 320,
  "semi": false,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "ignorePatterns": ["dist/**", "node_modules/**", "upm.lock", "docs/**"]
}
